---
import { getLiveCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import DayContent from '../components/DayContent.astro'
import { daySocialMetadata } from '../server/social'
import { dayCachePolicy, plainDay, shiftDay, today } from '../lib/dates'
const latestBefore = shiftDay(today(), 1)
let before = Astro.url.searchParams.get('before') || latestBefore
try {
  plainDay(before)
} catch {
  return new Response('Invalid date cursor', { status: 400 })
}
const { entries, error } = await getLiveCollection('days', { before, limit: 7 })
if (error) {
  console.error(JSON.stringify({ event: 'feed-error', message: error.message }))
  Astro.response.status = 503
}
const { social, failed: socialFailed } = await daySocialMetadata(
  entries?.[0]?.id || shiftDay(before, -1),
  Astro.url.searchParams.has('before') ? `/?before=${before}` : '/'
)
social.title = 'Latest · Days'
const cacheable =
  !error && !!entries && !entries.some((e) => e.data.warnings.length) && !socialFailed
Astro.response.headers.set(
  'Cache-Control',
  cacheable ? 'public, max-age=0, must-revalidate' : 'no-store'
)
if (Astro.cache.enabled) {
  Astro.cache.set(
    cacheable
      ? {
          ...dayCachePolicy(entries.map((entry) => entry.id)),
          tags: ['days', ...entries.map((entry) => `day:${entry.id}`)],
        }
      : false
  )
}
const older = entries?.at(-1)?.id
const newerBefore = shiftDay(before, 7)
const pagination = {
  older: older ? `/?before=${older}` : undefined,
  newer: before < latestBefore
    ? newerBefore >= latestBefore ? '/' : `/?before=${newerBefore}`
    : undefined,
}
---

<Layout activeDay={entries?.[0]?.id || shiftDay(before, -1)} social={social} pagination={pagination}>
  <section class="intro">
    <h1>Latest</h1>
  </section>
  {error ? (
    <section class="notice">
      <h2>Days is temporarily unavailable</h2>
      <p>The database may need configuration or migration. Please try again shortly.</p>
    </section>
  ) : (
    entries?.map((entry) => <DayContent day={entry.data} />)
  )}
  <nav class="pagination" aria-label="Feed pagination">
    <a href="/">Back to today</a>
    {older && (
      <a class="button" href={pagination.older}>
        Earlier days ↓
      </a>
    )}
  </nav>
</Layout>
