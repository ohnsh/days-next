---
import Layout from '../../layouts/Layout.astro'
import { dayBounds, plainDay, shiftDay, today } from '../../lib/dates'
import { readAdminState } from '../../server/editorial'
import { daysDatabase, vodAdminToken, vodBaseUrl } from '../../server/runtime'

let selected = Astro.url.searchParams.get('day') || today()
try {
  plainDay(selected)
} catch {
  return new Response('Invalid day', { status: 400 })
}
const first = shiftDay(selected, -30)
const db = daysDatabase()
const [vodResult, syncResult] = await Promise.all([
  readAdminState(
    dayBounds(first).start,
    dayBounds(selected).end,
    vodBaseUrl(),
    vodAdminToken()
  ).then(
    (data) => ({ data, error: '' }),
    (error) => ({
      data: { events: [], tags: [], cameras: [], warning: String(error) },
      error: String(error),
    })
  ),
  db.execute('SELECT * FROM sync_runs ORDER BY source'),
]).finally(() => db.close())
const { events, tags, cameras } = vodResult.data
const warning = vodResult.error || vodResult.data.warning
---

<Layout title="Administration" activeDay={selected}>
  <section class="page-intro">
    <h1>Days Admin</h1>
    <p class="muted">
      Signed in as {Astro.locals.admin?.email}. Events and recording protection are managed by VOD.
    </p>
    {warning && <p class="notice">{warning}</p>}
  </section>
  <div class="admin-grid">
    <form id="event-form" class="admin-form" data-day={selected}>
      <h2>VOD event</h2>
      <input type="hidden" name="id" value="" />
      <input type="hidden" name="version" value="0" />
      <label>
        Title
        <input name="title" maxlength="200" required />
      </label>
      <label>
        Notes<textarea name="notes" maxlength="16000"></textarea>
      </label>
      <label>
        Start <span class="muted">Chicago local time</span>
        <input
          type="datetime-local"
          name="start"
          step="0.001"
          value={`${selected}T12:00`}
          required
        />
      </label>
      <label>
        End <span class="muted">Chicago local time</span>
        <input type="datetime-local" name="end" step="0.001" value={`${selected}T13:00`} required />
      </label>
      <label>
        Camera scope
        <select name="cameraScope">
          <option value="all">All cameras</option>
          <option value="selected">Selected cameras</option>
        </select>
      </label>
      <label>
        Cameras <span class="muted">Used when scope is selected</span>
        <select name="cameraIds" multiple size="5">
          {cameras.map((camera) => (
            <option value={camera.id}>
              {camera.name} ({camera.id})
            </option>
          ))}
        </select>
      </label>
      <label>
        Tags <span class="muted">Comma-separated; new names create public VOD tags</span>
        <input name="tags" list="event-tags" placeholder="home, projects, a good day" />
        <datalist id="event-tags">
          {tags.map((tag) => (
            <option value={tag.name} />
          ))}
        </datalist>
      </label>
      <label class="checkbox">
        <input type="checkbox" name="protect" checked /> Protect recordings from pruning
      </label>
      <label class="checkbox">
        <input type="checkbox" name="isPublic" /> Publish on the day page
      </label>
      <div>
        <button type="submit">Save event</button> <button type="reset">New event</button>
      </div>
      <p id="status" class="status" role="status"></p>
    </form>
    <section>
      <h2>Source imports</h2>
      <div class="admin-list">
        {syncResult.rows.map((row) => (
          <article>
            <h3>{String(row.source)}</h3>
            <p>
              {Number(row.item_count).toLocaleString()} public items
              <br />
              <time>{String(row.finished_at)}</time>
            </p>
          </article>
        ))}
      </div>
      {!syncResult.rows.length && (
        <p class="notice">Run the seed or sync command to import source data.</p>
      )}
      <p class="muted">
        Imports run with <code>bun run sync</code>. The site reads the latest completed import
        immediately.
      </p>
      <h2>Recent events</h2>
      <form class="inline-form" method="get">
        <label for="event-day">Through</label>
        <input type="date" name="day" id="event-day" value={selected} />
        <button>Browse</button>
      </form>
      <p class="muted">Showing the preceding 31 days.</p>
      <div class="admin-list">
        {events.map((event) => (
          <article>
            <p class="eyebrow">
              {event.day} · {event.isPublic ? 'Public' : 'Private'} · {event.cameraScope} cameras
            </p>
            <h3>{event.title}</h3>
            <p class="prewrap">{event.notes}</p>
            <p>{event.tags.map((tag) => tag.name).join(' · ')}</p>
            <button
              type="button"
              data-edit={JSON.stringify(event)}
              disabled={event.version === undefined}
            >
              Edit
            </button>{' '}
            <button
              type="button"
              data-delete={JSON.stringify({ id: event.id, version: event.version })}
              disabled={event.version === undefined}
            >
              Delete
            </button>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>
<script>
  import { Temporal } from '@js-temporal/polyfill'

  const timezone = 'America/Chicago'
  const form = document.querySelector<HTMLFormElement>('#event-form')!
  const status = document.querySelector<HTMLElement>('#status')!
  const input = (name: string) => form.elements.namedItem(name) as HTMLInputElement
  const select = (name: string) => form.elements.namedItem(name) as HTMLSelectElement
  const toEpoch = (value: string) =>
    Temporal.PlainDateTime.from(value).toZonedDateTime(timezone, { disambiguation: 'reject' })
      .epochMilliseconds
  const fromEpoch = (value: number) => {
    const local = Temporal.Instant.fromEpochMilliseconds(value).toZonedDateTimeISO(timezone)
    return `${local.toPlainDate()}T${local.toPlainTime().toString({ smallestUnit: 'millisecond' })}`
  }

  async function mutate(method: string, body: unknown) {
    status.textContent = 'Saving…'
    try {
      const response = await fetch('/api/admin/events', {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      })
      const result = (await response.json()) as { error?: string }
      if (!response.ok) throw new Error(result.error || 'Request failed')
      location.assign(`/admin/?day=${encodeURIComponent(form.dataset.day || '')}`)
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Request failed'
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault()
    try {
      const id = input('id').value
      void mutate(id ? 'PUT' : 'POST', {
        id,
        version: Number(input('version').value),
        title: input('title').value,
        notes: input('notes').value,
        start: toEpoch(input('start').value),
        end: toEpoch(input('end').value),
        cameraScope: select('cameraScope').value,
        cameraIds: Array.from(select('cameraIds').selectedOptions, (option) => option.value),
        tags: input('tags')
          .value.split(',')
          .map((tag) => tag.trim())
          .filter(Boolean),
        protect: input('protect').checked,
        isPublic: input('isPublic').checked,
      })
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Invalid event time'
    }
  })

  document.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach((button) =>
    button.addEventListener('click', () => {
      const event = JSON.parse(button.dataset.edit!)
      input('id').value = String(event.id)
      input('version').value = String(event.version ?? 0)
      input('title').value = event.title
      input('notes').value = event.notes
      input('start').value = fromEpoch(event.start)
      input('end').value = fromEpoch(event.end)
      select('cameraScope').value = event.cameraScope
      const selected = new Set(event.cameraIds as string[])
      for (const option of select('cameraIds').options) option.selected = selected.has(option.value)
      input('tags').value = event.tags.map((tag: { name: string }) => tag.name).join(', ')
      input('protect').checked = Boolean(event.protect)
      input('isPublic').checked = Boolean(event.isPublic)
      form.scrollIntoView({ behavior: 'smooth', block: 'start' })
      input('title').focus()
      status.textContent = 'Editing existing event'
    })
  )

  document.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((button) =>
    button.addEventListener('click', () => {
      void mutate('DELETE', JSON.parse(button.dataset.delete!))
    })
  )

  form.addEventListener('reset', () => {
    input('id').value = ''
    input('version').value = '0'
    status.textContent = ''
  })
</script>
