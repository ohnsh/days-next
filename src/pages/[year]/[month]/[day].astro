---
import { getLiveEntry } from 'astro:content'
import Layout from '../../../layouts/Layout.astro'
import DayContent from '../../../components/DayContent.astro'
import { dayCachePolicy, dayTitle, dayUrl, plainDay, shiftDay } from '../../../lib/dates'
const key = `${Astro.params.year}-${Astro.params.month}-${Astro.params.day}`
try {
  plainDay(key)
} catch {
  return new Response('Day not found', { status: 404 })
}
const { entry, error } = await getLiveEntry('days', key)
if (error) {
  console.error(JSON.stringify({ event: 'day-error', day: key, message: error.message }))
  Astro.response.status = 503
}
const cacheable = !error && !!entry && !entry.data.warnings.length
Astro.response.headers.set(
  'Cache-Control',
  cacheable ? 'public, max-age=0, must-revalidate' : 'no-store'
)
if (Astro.cache.enabled) {
  Astro.cache.set(cacheable ? { ...dayCachePolicy(key), tags: ['days', `day:${key}`] } : false)
}
---

<Layout title={dayTitle(key)} activeDay={key}>
  {error ? (
    <p class="notice">This day is temporarily unavailable.</p>
  ) : (
    entry && <DayContent day={entry.data} expanded />
  )}
  <nav class="pagination" aria-label="Day navigation">
    <a href={dayUrl(shiftDay(key, -1))}>← Previous day</a>
    <a href={dayUrl(shiftDay(key, 1))}>Next day →</a>
  </nav>
</Layout>
