---
import { Image } from 'astro:assets'

interface Slide {
  image: ImageMetadata
  alt: string
  caption: string
}

interface Props {
  slides: Slide[]
}

const { slides } = Astro.props
---

<div class="slideshow" data-slideshow style={`--slide-count: ${slides.length}`}>
  <section class="toolbar" aria-label="Slideshow controls">
    <nav>
      <button type="button" data-prev aria-label="Previous slide">
        ←
      </button>
      <button type="button" data-next aria-label="Next slide">
        →
      </button>
    </nav>
    <p aria-live="polite">
      <span data-current>1</span> of {slides.length}
    </p>
  </section>
  <section class="viewport" aria-label="Slides">
    <div class="track">
      {slides.map(({ image, alt, caption }) => (
        <figure>
          <figcaption>{caption}</figcaption>
          <Image src={image} alt={alt} />
        </figure>
      ))}
    </div>
  </section>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((slideshow) => {
    let index = 0
    const count = Number.parseInt(slideshow.style.getPropertyValue('--slide-count'), 10)
    const update = () => {
      slideshow.style.setProperty('--index', String(index))
      const current = slideshow.querySelector('[data-current]')
      if (current) current.textContent = String(index + 1)
    }

    slideshow.querySelector('[data-prev]')?.addEventListener('click', () => {
      index = (index + count - 1) % count
      update()
    })
    slideshow.querySelector('[data-next]')?.addEventListener('click', () => {
      index = (index + 1) % count
      update()
    })
  })
</script>

<style>
  .slideshow {
    --index: 0;
    margin: 1.5rem auto;
    max-width: 500px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 0 0;
    color: var(--text);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 0.65rem;
  }

  .toolbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-inline: 1rem;

    p {
      grid-column: 3;
      justify-self: end;
      margin: 0;
      color: var(--text);
      font-size: 0.8rem;
    }

    nav {
      grid-column: 2;
      display: flex;
      gap: 0.35rem;

      button {
        min-width: 2.5rem;
        padding: 0.35rem 0.65rem;
      }
    }
  }

  .viewport {
    width: 100%;
    container-type: inline-size;
    overflow: hidden;
  }

  .track {
    display: flex;
    align-items: start;
    width: 100%;
    transform: translateX(calc(var(--index) * -100%));
    transition: transform 180ms ease;
  }

  figure {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 0.75rem;
    width: 100cqi;
    margin: 0;
    padding: 0.5rem 1rem 1rem;

    figcaption {
      padding-inline: 0.25rem;
      font-size: 0.9rem;
    }

    img {
      align-self: center;
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 450px;
      border-radius: 0.5rem;
      box-shadow: 0 0.3rem 1rem rgb(0 0 0 / 0.35);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      transition: none;
    }
  }
</style>
