---
import VodPlayer from 'vod-player-astro'
import YouTube from './YouTube.astro'
import Post from './Post.astro'
import { dayTitle, dayUrl } from '../lib/dates'
import { getPostsForDay } from '../lib/posts'
import type { Day, SourceItem } from '../lib/types'
import { isVideoCamera, isDefaultCamera } from '../lib/vod-view'
interface Props {
  day: Day
  expanded?: boolean
}
const { day, expanded = false } = Astro.props
const cameras = day.cameras.filter((camera) => isVideoCamera(camera.id))
const hasDefaultCameras = cameras.some((camera) => isDefaultCamera(camera.id))
const posts = await getPostsForDay(day.day)
const commits = day.items.filter((i) => i.source === 'github')
const videos = day.items.filter((i) => i.source === 'youtube')
const repos = new Map<string, SourceItem[]>()
for (const item of commits) repos.set(item.group, [...(repos.get(item.group) ?? []), item])
const videoCategoryOrder = ['🎙️', '🤳', '🐶', '🏃‍♂️', '🎣', '🚗']
const videoCategories = new Map<string, SourceItem[]>()
for (const video of videos) {
  const category = video.tags[0] ?? ''
  videoCategories.set(category, [...(videoCategories.get(category) ?? []), video])
}
const orderedVideoCategories = [...videoCategories.entries()].sort(([a], [b]) => {
  const aIndex = videoCategoryOrder.indexOf(a)
  const bIndex = videoCategoryOrder.indexOf(b)
  const aRank = aIndex === -1 ? videoCategoryOrder.length : aIndex
  const bRank = bIndex === -1 ? videoCategoryOrder.length : bIndex
  return aRank - bRank || a.localeCompare(b)
})
for (const [, items] of orderedVideoCategories) {
  items.sort((a, b) => a.title.localeCompare(b.title))
}
const count = posts.length + day.events.length + cameras.length + day.items.length
/*const summary = [
  { amount: posts.length, label: 'post' },
  { amount: day.cameras.length, label: 'camera' },
  { amount: day.events.length, label: 'event' },
  { amount: day.items.length, label: 'entry' },
]
  .filter(({ amount }) => amount > 0)
  .map(({ amount, label }) => `${amount} ${label}${amount === 1 ? '' : 's'}`)
  .join(' · ')*/
---

<article class="day-card">
  <header class="day-heading">
    <div>
      <h2>
        <a href={dayUrl(day.day)}>{dayTitle(day.day)}</a>
      </h2>
    </div>
    <!-- <span class="day-count">{count ? summary : 'An open page'}</span> -->
  </header>
  {day.warnings.map((warning) => (
    <p class="notice" role="status">
      {warning}
    </p>
  ))}
  {posts.length > 0 && (
    <section class="day-section writing-section">
      <h3>
        <span class="section-dot green"></span>Writing
      </h3>
      {posts.map((post) => (
        <Post post={post} mode="excerpt" titleLevel={3} />
      ))}
    </section>
  )}
  {day.events.length > 0 && (
    <section class="day-section">
      <h3>
        <span class="section-dot amber"></span>Noted
      </h3>
      {day.events.map((event) => (
        <article class="note">
          <h4>{event.title}</h4>
          <p class="prewrap">{event.notes}</p>
          <div class="tags">
            {event.tags.map((tag) => (
              <span>{tag.name}</span>
            ))}
          </div>
          {event.camera && event.at && (
            <a
              href={`https://vod.ohn.sh/embed?${new URLSearchParams({ camera: event.camera, at: event.at })}`}
            >
              Open this moment ↗
            </a>
          )}
        </article>
      ))}
    </section>
  )}
  {cameras.length > 0 && (
    <section class="day-section" data-vod-section>
      <h3>
        <span class="section-dot"></span>VOD{' '}
        <label class="vod-show-all">
          <input type="checkbox" data-vod-show-all /> Show all
        </label>
      </h3>
      {!hasDefaultCameras && (
        <p class="empty" data-vod-empty>
          No cameras in the default view.
        </p>
      )}
      <div class="media-grid">
        {cameras.map((camera) => (
          <article
            class="camera-card"
            data-vod-default={String(isDefaultCamera(camera.id))}
            hidden={!isDefaultCamera(camera.id)}
          >
            <VodPlayer
              poster={camera.poster || '/poster-placeholder.svg'}
              title={`${camera.name} — ${day.day}`}
              camera={camera.id}
              day={camera.playerDay}
              at={camera.at}
              scrubPreview
              controls="minimal"
              zoom="day"
            />
            <div class="media-caption">
              <h4>{camera.name}</h4>
              <span>{Math.round(camera.coveredMs / 60000).toLocaleString()} min</span>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}
  {videos.length > 0 && (
    <section class="day-section">
      <h3>
        <span class="section-dot red"></span>On YouTube{' '}
        <span class="section-meta">{videos.length} videos</span>
      </h3>
      {orderedVideoCategories.map(([category, items]) => (
        <div class="video-category">
          {!category && <h4>Other videos</h4>}
          <div class="media-grid">
            {items.map((item) => (
              <YouTube {item} />
            ))}
          </div>
        </div>
      ))}
    </section>
  )}
  {commits.length > 0 && (
    <section class="day-section">
      <h3>
        <span class="section-dot green"></span>GitHub commits{' '}
        <span class="section-meta">{commits.length} commits</span>
      </h3>
      <div class="repo-list">
        {[...repos].map(([repo, items]) => (
          <details open={expanded}>
            <summary>
              <span>{repo}</span>
              <span class="pill">{items.length}</span>
            </summary>
            <ul>
              {items
                .sort((a, b) => b.occurredAt.localeCompare(a.occurredAt))
                .map((item) => (
                  <li>
                    <a href={item.url}>{item.title}</a>
                    <code>{item.id.split(':').at(-1)?.slice(0, 7)}</code>
                  </li>
                ))}
            </ul>
          </details>
        ))}
      </div>
    </section>
  )}
  {!count && !day.warnings.length && <p class="empty">Nothing gathered for this day yet.</p>}
</article>

<style>
  [data-vod-section] [hidden] {
    display: none;
  }
  .vod-show-all {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    font-size: 0.8rem;
    font-weight: normal;
    cursor: pointer;
  }
</style>

<script>
  import { getShowAll, setShowAll, subscribeShowAll } from '../lib/vod-preference'

  function updateView() {
    const showAll = getShowAll()
    document.querySelectorAll<HTMLInputElement>('[data-vod-show-all]').forEach((input) => {
      input.checked = showAll
    })
    document.querySelectorAll<HTMLElement>('[data-vod-default="false"]').forEach((card) => {
      card.hidden = !showAll
    })
    document.querySelectorAll<HTMLElement>('[data-vod-empty]').forEach((message) => {
      message.hidden = showAll
    })
  }
  subscribeShowAll(updateView)
  updateView()
  document.addEventListener('change', (event) => {
    if (event.target instanceof HTMLInputElement && event.target.matches('[data-vod-show-all]')) {
      setShowAll(event.target.checked)
    }
  })
</script>
