---
import type { SourceItem } from '../lib/types'
interface Props {
  item: SourceItem
}
const { item } = Astro.props
const videoId = item.id.replace(/^youtube:/, '')
// Keep joined emoji, flags, and skin-tone modifiers together.
const firstGrapheme = new Intl.Segmenter(undefined, { granularity: 'grapheme' })
  .segment(item.title)[Symbol.iterator]().next().value?.segment ?? ''
const leadingEmoji = /[\p{Extended_Pictographic}\p{Regional_Indicator}\u20E3]/u.test(firstGrapheme)
  ? firstGrapheme
  : ''
---

<article class="youtube-card">
  <days-youtube
    data-video={videoId}
    data-title={item.title}
    data-short={item.isShort ? 'true' : undefined}
  >
    <button type="button" aria-label={`Load YouTube video: ${item.title}`}>
      {item.thumbnail && (
        <img src={item.thumbnail} alt="" loading="lazy" width="480" height="270" />
      )}
      <span class="play-icon" aria-hidden="true">
        ▶
      </span>
    </button>
  </days-youtube>
  <h4>
    <a href={item.url}>{leadingEmoji && <span class="title-emoji">{leadingEmoji}</span>}{item.title.slice(leadingEmoji.length)}</a>
  </h4>
  {item.description && (
    <details>
      <summary>Description</summary>
      <p class="prewrap">{item.description}</p>
    </details>
  )}
</article>
<style>
  .title-emoji {
    font-size: 1.3rem;
  }
</style>
<script>
  class DaysYouTube extends HTMLElement {
    connectedCallback() {
      this.querySelector('button')?.addEventListener(
        'click',
        () => {
          const iframe = document.createElement('iframe')
          iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(this.dataset.video!)}?autoplay=1`
          iframe.title = this.dataset.title || 'YouTube video'
          iframe.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture'
          iframe.allowFullscreen = true
          this.replaceChildren(iframe)
          iframe.focus()
        },
        { once: true }
      )
    }
  }
  if (!customElements.get('days-youtube'))
    customElements.define('days-youtube', DaysYouTube)
</script>
