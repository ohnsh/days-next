---
import '../styles/global.css'
import { dayUrl, shiftDay, today } from '../lib/dates'
import CalendarPicker from '../components/CalendarPicker'
import DaysLogo from '../components/DaysLogo.astro'
import { socialMeta, type SocialMetadata } from 'og-snap/meta'
interface Props {
  title?: string
  activeDay?: string
  social?: SocialMetadata
  pagination?: { older?: string; newer?: string }
}
const { title = 'Latest', activeDay = today(), social, pagination } = Astro.props
const currentToday = today()
const previousHref = pagination ? pagination.older : dayUrl(shiftDay(activeDay, -1))
const nextHref = pagination
  ? pagination.newer
  : activeDay < currentToday
    ? dayUrl(shiftDay(activeDay, 1))
    : undefined
const previousLabel = pagination ? 'Earlier days' : 'Previous day'
const nextLabel = pagination ? 'Newer days' : 'Next day'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={social?.description ?? 'Days.'} />
    {social && <link rel="canonical" href={social.url} />}
    {social && socialMeta(social).map((tag) => <meta {...tag} />)}
    <title>{title} · Days</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/" aria-label="Days — Today">
          <DaysLogo />
          <span>days.</span>
        </a>
        <days-calendar-nav>
          <a
            href={previousHref}
            aria-disabled={!previousHref ? 'true' : undefined}
            class="cal-step"
            aria-label={previousLabel}
            title={previousLabel}
          >
            ←
          </a>
          <CalendarPicker
            client:load
            activeDay={activeDay}
            today={currentToday}
            admin={Astro.url.pathname.startsWith('/admin/')}
          />
          <a
            href={nextHref}
            aria-disabled={!nextHref ? 'true' : undefined}
            class="cal-step"
            aria-label={nextLabel}
            title={nextLabel}
          >
            →
          </a>
          {activeDay !== currentToday && (
            <a href="/" class="cal-today">
              Today
            </a>
          )}
        </days-calendar-nav>
        <div class="header-account">
          <span class="header-name">
            <a href="https://j.ohn.sh">John Sherrell</a>
          </span>
          <details class="header-menu">
            <summary aria-label="Navigation menu" aria-controls="header-navigation">
              <span class="nav-chevron" aria-hidden="true"></span>
            </summary>
            <nav id="header-navigation" aria-label="Main navigation">
              <span class="menu-name">
                <a class="menu-source" href="https://j.ohn.sh">
                  <span class="menu-icon-spacer" aria-hidden="true"></span>
                  John Sherrell
                </a>
              </span>
              <a class="menu-source" href="/admin/">
                <span class="menu-icon-spacer" aria-hidden="true"></span>
                Admin
              </a>
              <hr class="menu-separator" />
              <a
                class="menu-source"
                href="https://vod.ohn.sh"
                aria-label="VOD — vod.ohn.sh"
              >
                <svg
                  viewBox="0 0 512 512"
                  fill="currentColor"
                  aria-hidden="true"
                  focusable="false"
                >
                  <g transform="translate(54.3 -70.25) scale(.7 1.875)">
                    <path d="M42 0h65C151 67 174 92 215 92H800v44H215C137 136 101 84 42 0Z" />
                    <path
                      opacity=".75"
                      d="M0 0h42C101 84 137 136 215 136H800v40H215C117 176 59 111 0 24Z"
                    />
                    <path
                      opacity=".5"
                      d="M0 24C59 111 117 176 215 176H800v40H215C115 216 44 160 0 90Z"
                    />
                    <path
                      opacity=".25"
                      d="M0 90C44 160 115 216 215 216H800v40H215C119 256 45 213 0 157Z"
                    />
                  </g>
                </svg>
                vod.ohn.sh
              </a>
              <a class="menu-source" href="https://www.youtube.com/@ohn-sh">
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path
                    fill-rule="evenodd"
                    d="M6 5a4 4 0 0 0-4 4v6a4 4 0 0 0 4 4h12a4 4 0 0 0 4-4V9a4 4 0 0 0-4-4H6Zm4 4v6l6-3-6-3Z"
                  />
                </svg>
                YouTube Channel
              </a>
              <a class="menu-source" href="https://github.com/ohnsh/days-next">
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.104.768-.244.768-.542 0-.267-.01-.974-.015-1.912-3.13.68-3.791-1.508-3.791-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.022-.699.077-.685.077-.685 1.13.08 1.725 1.16 1.725 1.16 1.005 1.723 2.638 1.225 3.28.937.103-.728.393-1.225.715-1.507-2.499-.284-5.126-1.25-5.126-5.565 0-1.23.44-2.233 1.16-3.02-.116-.285-.503-1.43.11-2.98 0 0 .945-.303 3.094 1.154A10.78 10.78 0 0 1 12 6.19c.956.004 1.918.13 2.817.379 2.148-1.457 3.091-1.154 3.091-1.154.615 1.55.228 2.695.112 2.98.722.787 1.158 1.79 1.158 3.02 0 4.327-2.631 5.278-5.138 5.557.404.35.765 1.042.765 2.1 0 1.516-.014 2.739-.014 3.11 0 .3.203.65.774.54A11.25 11.25 0 0 0 12 .75Z" />
                </svg>
                Days on GitHub
              </a>
            </nav>
          </details>
        </div>
        <script>
          const menu = document.querySelector<HTMLDetailsElement>('.header-menu')
          document.addEventListener('click', (event) => {
            if (event.target instanceof Node && !menu?.contains(event.target) && menu) {
              menu.open = false
            }
          })
          document.addEventListener('keydown', (event) => {
            if (
              event.key === 'Escape' &&
              menu?.open &&
              menu.contains(document.activeElement)
            ) {
              menu.open = false
              menu.querySelector('summary')?.focus()
            }
          })
        </script>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>John Sherrell</span>
    </footer>
  </body>
</html>
