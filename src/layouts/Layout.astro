---
import '../styles/global.css'
import { dayUrl, shiftDay, today } from '../lib/dates'
import CalendarPicker from '../components/CalendarPicker'
import DaysLogo from '../components/DaysLogo.astro'
import { socialMeta, type SocialMetadata } from 'og-snap/meta'
interface Props {
  title?: string
  activeDay?: string
  social?: SocialMetadata
}
const { title = 'Latest', activeDay = today(), social } = Astro.props
const currentToday = today()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={social?.description ?? 'Days — an archive.'} />
    {social && <link rel="canonical" href={social.url} />}
    {social && socialMeta(social).map((tag) => <meta {...tag} />)}
    <title>{title} · Days</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="/" aria-label="Days — Today">
          <DaysLogo />
          <span>days.</span>
        </a>
        <days-calendar-nav>
          <a
            href={dayUrl(shiftDay(activeDay, -1))}
            class="cal-step"
            aria-label="Previous day"
            title="Previous day"
          >
            ←
          </a>
          <CalendarPicker
            client:load
            activeDay={activeDay}
            today={currentToday}
            admin={Astro.url.pathname.startsWith('/admin/')}
          />
          <a
            href={activeDay < currentToday ? dayUrl(shiftDay(activeDay, 1)) : undefined}
            aria-disabled={activeDay >= currentToday ? 'true' : undefined}
            class="cal-step"
            aria-label="Next day"
            title="Next day"
          >
            →
          </a>
          {activeDay !== currentToday && (
            <a href="/" class="cal-today">
              Today
            </a>
          )}
        </days-calendar-nav>
        <div class="header-account">
          <span class="header-name">John Sherrell</span>
          <details class="header-menu">
            <summary aria-label="Navigation menu" aria-controls="header-navigation">
              <span class="nav-chevron" aria-hidden="true"></span>
            </summary>
            <nav id="header-navigation" aria-label="Main navigation">
              <span class="menu-name">John Sherrell</span>
              <a href="https://vod.ohn.sh">VOD ↗</a>
              <a href="/admin/">Admin</a>
            </nav>
          </details>
        </div>
        <script>
          const menu = document.querySelector<HTMLDetailsElement>('.header-menu')
          document.addEventListener('click', (event) => {
            if (event.target instanceof Node && !menu?.contains(event.target) && menu) {
              menu.open = false
            }
          })
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && menu?.open) {
              menu.open = false
              menu.querySelector('summary')?.focus()
            }
          })
        </script>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>John Sherrell</span>
    </footer>
  </body>
</html>
