---
import '../styles/global.css'
import { dayUrl, shiftDay, today } from '../lib/dates'
interface Props {
  title?: string
  activeDay?: string
}
const { title = 'Latest', activeDay = today() } = Astro.props
const currentToday = today()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Days — an archive." />
    <title>{title} · Days</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
          <a class="wordmark" href="/" aria-label="Days — Today">
            <svg
              aria-hidden="true"
              width="30"
              height="30"
              viewBox="-2 -2 28 28"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="18" height="18" x="3" y="3" rx="2" />
              <path d="M17 12h-2l-2 5-2-10-2 5H7" />
            </svg>
            <span>days.</span>
          </a>
        <days-calendar-nav>
          <a
            href={dayUrl(shiftDay(activeDay, -1))}
            class="cal-step"
            aria-label="Previous day"
            title="Previous day"
          >
            ←
          </a>
          <form action="/" method="get" class="cal-picker">
            <input type="date" name="before" value={activeDay} aria-label="Jump to date" />
          </form>
          <a
            href={dayUrl(shiftDay(activeDay, 1))}
            class="cal-step"
            aria-label="Next day"
            title="Next day"
          >
            →
          </a>
          {activeDay !== currentToday && (
            <a href="/" class="cal-today">
              Today
            </a>
          )}
          <script>
            const calendarNav = document.querySelector('days-calendar-nav')
            const dateInput = calendarNav?.querySelector<HTMLInputElement>('input[type="date"]')
            dateInput?.addEventListener('change', () => {
              const value = dateInput.value
              if (!value) return
              const destination = location.pathname.startsWith('/admin/')
                ? `/admin/?day=${value}`
                : `/${value.replaceAll('-', '/')}/`
              location.assign(destination)
            })
          </script>
        </days-calendar-nav>
        <div class="header-account">
          <span class="header-name">John Sherrell</span>
          <details class="header-menu">
            <summary aria-label="Navigation menu" aria-controls="header-navigation">
              <span class="nav-chevron" aria-hidden="true"></span>
            </summary>
            <nav id="header-navigation" aria-label="Main navigation">
              <span class="menu-name">John Sherrell</span>
              <a href="https://vod.ohn.sh">VOD ↗</a>
              <a href="/admin/">Admin</a>
            </nav>
          </details>
        </div>
        <script>
          const menu = document.querySelector<HTMLDetailsElement>('.header-menu')
          document.addEventListener('click', (event) => {
            if (event.target instanceof Node && !menu?.contains(event.target) && menu) {
              menu.open = false
            }
          })
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && menu?.open) {
              menu.open = false
              menu.querySelector('summary')?.focus()
            }
          })
        </script>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>John Sherrell</span>
    </footer>
  </body>
</html>
