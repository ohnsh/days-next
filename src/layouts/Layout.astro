---
import '../styles/global.css'
import { dayUrl, shiftDay, today } from '../lib/dates'
interface Props {
  title?: string
  activeDay?: string
}
const { title = 'Latest', activeDay = today() } = Astro.props
const currentToday = today()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Days — an archive." />
    <title>{title} · Days</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <div class="header-top">
          <a class="wordmark" href="/" aria-label="Days home">
            <svg
              aria-hidden="true"
              width="26"
              height="26"
              viewBox="-2 -2 28 28"
              fill="none"
              stroke="var(--accent)"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="18" height="18" x="3" y="3" rx="2" />
              <path d="M17 12h-2l-2 5-2-10-2 5H7" />
            </svg>
            days<span>.</span>
          </a>
          <nav aria-label="Main navigation">
            <a href="https://vod.ohn.sh">VOD ↗</a>
            <a href="/admin/">Admin</a>
          </nav>
        </div>
        <days-calendar-nav>
          <a
            href={dayUrl(shiftDay(activeDay, -1))}
            class="cal-step"
            aria-label="Previous day"
            title="Previous day">←</a
          >
          <form action="/" method="get" class="cal-picker">
            <input type="date" name="before" value={activeDay} aria-label="Jump to date" />
          </form>
          <a
            href={dayUrl(shiftDay(activeDay, 1))}
            class="cal-step"
            aria-label="Next day"
            title="Next day">→</a
          >
          {activeDay !== currentToday && <a href="/" class="cal-today">Today</a>}
          <script>
            const calendarNav = document.querySelector('days-calendar-nav')
            const dateInput = calendarNav?.querySelector<HTMLInputElement>('input[type="date"]')
            dateInput?.addEventListener('change', () => {
              const value = dateInput.value
              if (!value) return
              const destination = location.pathname.startsWith('/admin/')
                ? `/admin/?day=${value}`
                : `/${value.replaceAll('-', '/')}/`
              location.assign(destination)
            })
          </script>
        </days-calendar-nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>John Sherrell</span>
    </footer>
  </body>
</html>
