{
  "name": "days-next",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:prod-vod": "CLOUDFLARE_ENV=prod-vod astro dev",
    "db:dev": "mkdir -p .data && turso dev --db-file .data/days.db --port 8080",
    "types": "wrangler types",
    "build": "astro build",
    "check": "astro check",
    "test": "bun test test",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:calendar": "node scripts/calendar-smoke.mjs",
    "preview": "astro preview",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:seed": "bun run scripts/seed.ts",
    "sync": "bun run scripts/sync.ts",
    "sync:git": "bun run scripts/sync-git.ts",
    "sync:full": "bun run scripts/sync.ts --full",
    "social:capture": "bun run scripts/capture-social.ts",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.7",
    "@astrojs/mdx": "^8.1.5",
    "@astrojs/react": "^7.1.8",
    "@js-temporal/polyfill": "0.5.1",
    "@libsql/client": "0.18.0",
    "@srcery-colors/srcery-palette": "^2.1.0",
    "astro": "^7.4.11",
    "jose": "^6.2.17",
    "og-snap": "link:og-snap",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "vod-player-astro": "link:vod-player-astro",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "6.0.3",
    "wrangler": "^4.161.0"
  }
}
