{
  "name": "days-next",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:prod-vod": "test -f .dev.vars.prod-vod && CLOUDFLARE_ENV=prod-vod astro dev",
    "db:dev": "mkdir -p .data && turso dev --db-file .data/days.db --port 8080",
    "types": "wrangler types",
    "build": "astro build",
    "check": "astro check",
    "test": "bun test test",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:calendar": "node scripts/calendar-smoke.mjs",
    "preview": "astro preview",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:seed": "bun run scripts/seed.ts",
    "sync": "bun run scripts/sync.ts",
    "sync:full": "bun run scripts/sync.ts --full",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.1",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.2",
    "@js-temporal/polyfill": "0.5.1",
    "@libsql/client": "0.18.0",
    "@srcery-colors/srcery-palette": "^2.0.0",
    "astro": "7.4.1",
    "jose": "6.2.12",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "vod-player-astro": "file:../vod/packages/player-astro",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "6.0.3",
    "wrangler": "4.151.3"
  }
}
