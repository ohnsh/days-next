{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "days-next",
  "routes": [
    {
      "pattern": "days-next.ohn.sh",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": true,
  // Latest date supported by the adapter's installed workerd binary.
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "VOD_BASE_URL": "https://vod.ohn.sh", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" },
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.01 } },
}
